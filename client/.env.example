# Copy to client/.env to enable Firebase Auth (Google + email/password) and
# Firestore storage. Values come from Firebase console -> Project settings ->
# Your apps -> Web app config. Also enable the Google and Email/Password
# sign-in providers and create a Firestore database in the project.
#
# Leave unset to run against the local Express store instead (zero setup).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
